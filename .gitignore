# dependencies
**/node_modules/

# React Router 생성물
**/.react-router/
**/build/

# 환경변수: 실제 값은 올리지 않고 .env.example만 올린다
**/.env
**/.env.*
!**/.env.example

# 로컬 DB·백업·업로드
**/data/
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3
**/backups/
**/uploads/*
!**/uploads/.gitkeep

# 테스트·로그
**/coverage/
**/*.log

# 편집기·OS
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
__pycache__/
