{
  "name": "rr7-midpoint-board",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/@react-router/dev/bin.js dev",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env node_modules/@react-router/serve/bin.js build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:requests": "node tools/request-test.mjs"
  },
  "dependencies": {
    "@react-router/node": "^7.18.6",
    "@react-router/serve": "^7.18.6",
    "isbot": "^5.1.36",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.6",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.1.1"
  }
}
