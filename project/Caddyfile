# {$DOMAIN} 이름의 사이트를 HTTPS로 받아 app 컨테이너로 넘긴다.
# 도메인의 A 레코드가 이 서버의 공인 IP를 가리키고 80·443 포트가 열려 있어야 인증서가 발급된다.
{$DOMAIN} {
	encode zstd gzip

	# 실시간(SSE·WebSocket) 연결이 프록시에서 버퍼링되거나 끊기지 않게 한다.
	reverse_proxy app:3000 {
		flush_interval -1
	}

	header {
		# 브라우저가 앞으로 HTTPS로만 접속하게 한다(앱도 같은 헤더를 보낸다).
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		-Server
	}
}
