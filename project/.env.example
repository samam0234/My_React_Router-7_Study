# 복사해서 .env를 만든 뒤 값을 채운다. .env는 Git에 올리지 않는다.
# 빈 값(KEY=)은 "설정 안 함"으로 보고 코드의 기본값을 쓴다.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# ── 보안 ─────────────────────────────────────────────────────────
# 32자 이상. 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
# HTTPS 뒤에서 운영할 때 true (기본: production이면 true)
COOKIE_SECURE=
# 브라우저에서 이 API를 직접 부를 다른 출처(쉼표로 여러 개). 비우면 같은 출처만.
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT=1
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=300
# 리버스 프록시(nginx, 클라우드 로드밸런서) 뒤에서만 1
TRUST_PROXY=0
# 비우면 /metrics가 꺼진다. 값을 주면 Authorization: Bearer <값> 으로만 열린다.
METRICS_TOKEN=

# ── 데이터베이스 ──────────────────────────────────────────────────
# sqlite | postgres | mariadb | mongo
DB_DRIVER=sqlite
DATABASE_PATH=./data/board.db
# postgres://사용자:비밀번호@호스트:5432/board
# mariadb://사용자:비밀번호@호스트:3306/board
# mongodb://호스트:27017/board
DATABASE_URL=

# ── 메일(log: 보내지 않고 로그만 / resend: Resend API) ─────────────
MAIL_DRIVER=log
MAIL_FROM=RR7 Board <onboarding@resend.dev>
RESEND_API_KEY=

# ── 결제(Stripe 테스트 모드) ──────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── 소셜 로그인(GitHub OAuth App: 콜백 주소는 APP_ORIGIN/auth/github/callback) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── 파일 업로드 ───────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=2000000

# ── AI(Ollama) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL=gemma4:12b

# ── 운영 ─────────────────────────────────────────────────────────
LOG_REQUESTS=1
BACKUP_DIR=./data/backups
